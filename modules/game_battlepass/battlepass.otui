      Label
        anchors.left: prev.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 48
        font: verdana-11px-rounded
        color: #888888
        text: Reward
    ScrollablePanel
      id: rewardsListScroll
      anchors.top: rewardsListColHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 2 4 4 4
      vertical-scrollbar: rewardsListScrollBar
      padding-right: 8
      layout:
        type: verticalBox
        spacing: 1
    VerticalScrollBar
      id: rewardsListScrollBar
      anchors.top: rewardsListScroll.top
      anchors.bottom: rewardsListScroll.bottom
      anchors.right: parent.right
      margin-right: 2
      step: 22
      pixels-scroll: true
  ScrollablePanel
    id: missionsBackground
    height: 441
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 44
    horizontal-scrollbar: progressPanelScrollBar
    padding: 1
    phantom: true
    inverted-view: true
    Panel
      id: progressPanelContent
      size: 37700 439
      anchors.top: parent.top
      anchors.left: parent.left
      @onSetup: |
        local prevId
        for i = 0, 71 do
          local widget = g_ui.createWidget('MapFragment', self)
          widget:setId('mapFragment' .. i)
          widget:setImageSource("/images/game/battlepass/map/tyronpass-background_" .. (i + 1))
          widget:addAnchor(AnchorVerticalCenter, 'parent', AnchorVerticalCenter)
          if prevId then
            widget:addAnchor(AnchorLeft, prevId, AnchorRight)
          else
            widget:addAnchor(AnchorLeft, 'parent', AnchorLeft)
          end
          widget:lower()
          prevId = 'mapFragment' .. i
        end
        local outfit = g_ui.createWidget('UICreature', self)
        outfit:setId('playerOutfit')
        outfit:setFocusable(false)
        outfit:setPhantom(true)
        outfit:setSize({width = 64, height = 64})
        outfit:addAnchor(AnchorTop, 'parent', AnchorTop)
        outfit:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        outfit:setMarginLeft(165)
        outfit:setMarginTop(214)


  HorizontalScrollBar
    id: progressPanelScrollBar
    anchors.bottom: prev.bottom
    anchors.right: prev.right
    anchors.left: prev.left
    step: 100
    margin: 0 1 1 1
    pixels-scroll: true
    visible: true
    phantom: true
    inverted-view: true
  UIButton
    id: skipButton
    size: 24 24
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    margin-left: 5
    image-source: /images/game/battlepass/skip
    !tooltip: tr('Jump to current position')
  UIButton
    id: playButton
    size: 24 24
    anchors.top: parent.top
    anchors.left: skipButton.right
    margin-top: 5
    margin-left: 4
    image-source: /images/game/battlepass/play
    !tooltip: tr('Walk to current position')
  UIButton
    id: dropRewardButton
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    image-source: /images/game/battlepass/dropReward
    !tooltip: tr('Toggle rewards list')

NewHeadlessWindow
  id: battlePassWindow
  anchors.horizontalCenter: parent.horizontalCenter
  size: 998 606
  @onEscape: hide()
  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -33
    image-source: /images/game/tutorial/backdrop_crestr
    phantom: true
  Panel
    id: mainPanel
    anchors.fill: parent
    margin: 15 13 17 13
    Panel
      id: optionsTabBar
      height: 36
      image-source: /images/game/destiny_wheel/menuBg
      image-border: 1
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      Button
        id: challengesMenu
        anchors.top: parent.top
        anchors.left: parent.left
        size: 323 34
        margin-left: 1
        margin-top: 1
        image-source: /images/game/battlepass/battlepass_menu
        image-clip: 0 0 384 34
        $hover !checked:
          image-clip: 0 0 384 34
        $pressed:
          image-clip: 0 34 384 34
        $checked:
          image-clip: 0 34 384 34
        @onClick: loadMenu('challengesMenu')
      Button
        id: rewardsMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 323 34
        margin-left: 1
        margin-top: 1
        image-source: /images/game/battlepass/battlepass_menu
        image-clip: 0 68 383 34
        $hover !checked:
          image-clip: 0 68 383 34
        $pressed:
          image-clip: 0 102 383 34
        $checked:
          image-clip: 0 102 383 34
        @onClick: loadMenu('rewardsMenu')
      Button
        id: shopMenu
        anchors.top: parent.top
        anchors.left: prev.right
        anchors.right: parent.right
        height: 34
        margin-left: 1
        margin-top: 1
        margin-right: 1
        image-source: /images/game/battlepass/battlepass_menu
        image-clip: 0 136 383 34
        $hover !checked:
          image-clip: 0 136 383 34
        $pressed:
          image-clip: 0 170 383 34
        $checked:
          image-clip: 0 170 383 34
        @onClick: loadMenu('shopMenu')

    Panel
      id: contentPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: separator.top
      margin-top: 12
      margin-bottom: 8
      MissionPanel
        id: missionPanel
        visible: true
      ProgressPanel
        id: progressPanel
        visible: false
      ScrollablePanel
        id: shopPanel
        anchors.fill: parent
        vertical-scrollbar: shopScrollBar
        padding: 8
        visible: false
        layout:
          type: grid
          cell-size: 296 146
          cell-spacing: 6
          num-columns: 3
      VerticalScrollBar
        id: shopScrollBar
        anchors.top: shopPanel.top
        anchors.bottom: shopPanel.bottom
        anchors.right: shopPanel.right
        step: 30
        pixels-scroll: true
        visible: true

    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 10
    Button
      id: close
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Close')
      size: 43 20
      @onClick: hide()
    
    Button
      id: bPassWiki
      size: 80 20
      image-source: /images/ui/buttons-blue
      image-border: 2
      anchors.bottom: parent.bottom
      anchors.right: prev.left
