// =============================================================================
//  DEFAULT ? right panel (gameMainRightPanel)
//  Edit freely: positions, visibility, adding/removing widgets.
// =============================================================================

PhantomMiniWindow
  id: mainmappanel
  draggable: true
  phantom: false
  &save: true
  &panelHeight: 115
  height: 115

  UIWidget
    id: layoutDefault
    anchors.fill: parent
    phantom: true

    UIWidget
      id: minimapBorder
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      margin-left: 8
      size: 108 111
      image-source: /images/ui/1pixel-down-frame

      Minimap
        id: minimap
        anchors.fill: parent
        margin: 1

    Button
      id: downloadMapButton
      !text: tr('Download Map')
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-bottom: 5
      width: 90
      height: 18
      @onClick: modules.game_minimap.downloadFullMap()

    UIWidget
      id: layersPanel
      size: 20 68
      margin-bottom: 1
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 7

      UIWidget
        id: automapLayers
        image-source: /images/automap/automap_indicator_maplayers
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-left: -1
        margin-bottom: 1
        image-clip: 98 0 14 67
        size: 14 67

      UIWidget
        id: layersSeparator
        image-source: /images/ui/separator_vertical
        margin-left: 3
        margin-top: 3
        margin-bottom: 4
        anchors.left: automapLayers.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 2

      Button
        image-source: /images/automap/automap_phantom
        image-border: 0
        padding: 0
        anchors.left: automapLayers.left
        anchors.right: automapLayers.right
        anchors.top: automapLayers.top
        anchors.bottom: automapLayers.verticalCenter
        @onClick: upLayer()
        $pressed:
          image-source: /images/automap/automap_phantom
        $hover !pressed:
          image-source: /images/automap/automap_phantom

      Button
        image-source: /images/automap/automap_phantom
        image-border: 0
        padding: 0
        anchors.left: automapLayers.left
        anchors.right: automapLayers.right
        anchors.top: automapLayers.verticalCenter
        anchors.bottom: automapLayers.bottom
        @onClick: downLayer()
        $pressed:
          image-source: /images/automap/automap_phantom
        $hover !pressed:
          image-source: /images/automap/automap_phantom

      UIWidget
        id: layersMark
        anchors.left: layersSeparator.right
        anchors.top: automapLayers.top
        image-source: /images/automap/automap_indicator_slider_left
        margin-top: 27
        margin-left: -3
        focusable: true

    UIWidget
      id: minimapControls
      anchors.right: layersPanel.left
      anchors.bottom: minimapBorder.bottom
      margin-right: 4
      size: 20 62

      Button
        id: fullMap
        image-source: /images/automap/automap_buttons
        image-clip: 0 0 20 20
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        size: 20 20
        @onClick: modules.game_cyclopedia.show("map")

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 0 20 20

      Button
        id: zoomIn
        image-source: /images/automap/automap_buttons
        image-clip: 0 40 20 20
        anchors.right: fullMap.right
        anchors.bottom: fullMap.top
        margin-bottom: 1
        size: 20 20
        @onClick: zoomIn()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 40 20 20

      Button
        id: zoomOut
        image-source: /images/automap/automap_buttons
        image-clip: 0 20 20 20
        anchors.right: fullMap.right
        anchors.bottom: zoomIn.top
        margin-bottom: 1
        size: 20 20
        @onClick: zoomOut()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 20 20 20

    UIWidget
      id: rosePanel
      anchors.top: minimapBorder.top
      anchors.right: layersPanel.right
      size: 43 43

      UIWidget
        id: ambients
        anchors.centerIn: parent
        size: 31 31

        UIWidget
          id: main
          image-source: /images/automap/timedisplay_scroll
          anchors.left: parent.left
          anchors.top: parent.top
          image-clip: 100 0 24 31
          size: 24 31

        UIWidget
          id: secondary
          image-source: /images/automap/timedisplay_scroll
          anchors.left: main.right
          anchors.top: parent.top
          image-clip: 0 0 7 31
          size: 7 31

        Button
          image-source: /images/automap/automap_phantom
          image-border: 0
          padding: 0
          anchors.fill: parent
          @onClick: resetMap()
          $pressed:
            image-source: /images/automap/automap_phantom
          $hover !pressed:
            image-source: /images/automap/automap_phantom

      UIWidget
        id: rose
        anchors.fill: parent
        image-source: /images/automap/automap_rose
        image-clip: 0 0 43 43
        phantom: true

      UIWidget
        id: timedisplayGlass
        image-source: /images/automap/timedisplay-glass
        anchors.centerIn: parent
        size: 43 43
        phantom: true

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 0 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        size: 15 8
        @onClick: |
          onClickRoseButton('north')

        $pressed !disabled:
          image-clip: 57 0 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('north-east')

        $pressed !disabled:
          image-clip: 114 0 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 35 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 35
        margin-top: 14
        size: 8 15
        @onClick: |
          onClickRoseButton('east')

        $pressed !disabled:
          image-clip: 164 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        margin-top: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('south-east')

        $pressed !disabled:
          image-clip: 200 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 35 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 35
        size: 15 8
        @onClick: |
          onClickRoseButton('south')

        $pressed !disabled:
          image-clip: 229 35 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('south-west')

        $pressed !disabled:
          image-clip: 258 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 14
        size: 8 15
        @onClick: |
          onClickRoseButton('west')

        $pressed !disabled:
          image-clip: 301 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        size: 15 15
        @onClick: |
          onClickRoseButton('north-west')

        $pressed !disabled:
          image-clip: 344 0 15 15

  // ===========================================================================
  //  --- organizational separator ---
  // ===========================================================================
  //
  //  HORIZONTAL ? top panels (gameLeftTopPanel / gameRightTopPanel)
  //  Independent copy of Default: change, hide or add widgets without
  //  affecting the vertical layout. The Minimap widget is unique and moved here by Lua.
  // ===========================================================================

  UIWidget
    id: layoutHorizontal
    anchors.fill: parent
    visible: false
    phantom: true

    UIWidget
      id: minimapBorder
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 1
      margin-left: 1
      margin-right: 1
      margin-bottom: 1

    Button
      id: fullMap
      image-source: /images/automap/automap_buttons
      image-clip: 0 0 20 20
      anchors.left: minimapBorder.left
      anchors.bottom: minimapBorder.bottom
      margin-left: 3
      margin-bottom: 3
      size: 20 20
      @onClick: modules.game_cyclopedia.show("map")

      $pressed !disabled:
        image-source: /images/automap/automap_buttons
        image-clip: 20 0 20 20

    Button
      id: downloadMapButtonHorizontal
      !text: tr('Download Map')
      anchors.horizontalCenter: minimapBorder.horizontalCenter
      anchors.bottom: minimapBorder.bottom
      margin-bottom: 3
      width: 90
      height: 20
      @onClick: modules.game_minimap.downloadFullMap()

    UIWidget
      id: minimapControls
      anchors.right: minimapBorder.right
      anchors.bottom: minimapBorder.bottom
      margin-right: 3
      margin-bottom: 3
      size: 44 44

      Button
        id: layerDown
        image-source: /images/automap/automap_buttons
        image-clip: 0 80 20 20
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        size: 20 20
        @onClick: downLayer()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 80 20 20

      Button
        id: zoomIn
        image-source: /images/automap/automap_buttons
        image-clip: 0 40 20 20
        anchors.right: layerDown.left
        anchors.bottom: parent.bottom
        margin-right: 2
        size: 20 20
        @onClick: zoomIn()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 40 20 20

      Button
        id: layerUp
        image-source: /images/automap/automap_buttons
        image-clip: 0 60 20 20
        anchors.right: parent.right
        anchors.bottom: layerDown.top
        margin-bottom: 2
        size: 20 20
        @onClick: upLayer()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 60 20 20

      Button
        id: zoomOut
        image-source: /images/automap/automap_buttons
        image-clip: 0 20 20 20
        anchors.right: layerUp.left
        anchors.bottom: layerUp.bottom
        margin-right: 2
        size: 20 20
        @onClick: zoomOut()

        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 20 20 20

    UIWidget
      id: rosePanel
      anchors.top: minimapBorder.top
      anchors.right: minimapBorder.right
      size: 43 43
      margin-right: 3
      margin-top: 3

      UIWidget
        id: ambients
        anchors.centerIn: parent
        size: 31 31

        UIWidget
          id: main
          image-source: /images/automap/timedisplay_scroll
          anchors.left: parent.left
          anchors.top: parent.top
          image-clip: 100 0 24 31
          size: 24 31

        UIWidget
          id: secondary
          image-source: /images/automap/timedisplay_scroll
          anchors.left: main.right
          anchors.top: parent.top
          image-clip: 0 0 7 31
          size: 7 31

        Button
          image-source: /images/automap/automap_phantom
          image-border: 0
          padding: 0
          anchors.fill: parent
          @onClick: resetMap()
          $pressed:
            image-source: /images/automap/automap_phantom
          $hover !pressed:
            image-source: /images/automap/automap_phantom

      UIWidget
        id: rose
        anchors.fill: parent
        image-source: /images/automap/automap_rose
        image-clip: 0 0 43 43
        phantom: true

      UIWidget
        id: timedisplayGlass
        image-source: /images/automap/timedisplay-glass
        anchors.centerIn: parent
        size: 43 43
        phantom: true

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 0 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        size: 15 8
        @onClick: |
          onClickRoseButton('north')

        $pressed !disabled:
          image-clip: 57 0 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('north-east')

        $pressed !disabled:
          image-clip: 114 0 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 35 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 35
        margin-top: 14
        size: 8 15
        @onClick: |
          onClickRoseButton('east')

        $pressed !disabled:
          image-clip: 164 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        margin-top: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('south-east')

        $pressed !disabled:
          image-clip: 200 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 35 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 35
        size: 15 8
        @onClick: |
          onClickRoseButton('south')

        $pressed !disabled:
          image-clip: 229 35 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 28
        size: 15 15
        @onClick: |
          onClickRoseButton('south-west')

        $pressed !disabled:
          image-clip: 258 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 14
        size: 8 15
        @onClick: |
          onClickRoseButton('west')

        $pressed !disabled:
          image-clip: 301 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        size: 15 15
        @onClick: |
          onClickRoseButton('north-west')

        $pressed !disabled:
          image-clip: 344 0 15 15

    UIWidget
      id: horizontalDragHandle
      anchors.top: minimapBorder.top
      anchors.left: minimapBorder.left
      image-source: /images/ui/miniborder-top-left
      image-smooth: false
      size: 14 14
      margin-top: 1
      margin-left: 1
      focusable: false
