        color: #c0c0c0
        text-offset: 0 -1
        text-align: center
        text-auto-resize: false

      HelperListColumnSeparator
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 23

      Label
        id: friendPlayerNameHeader
        width: 160
        !text: tr('Player')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 28
        font: $var-cip-font
        color: #c0c0c0
        text-offset: 0 -1
        text-align: center
        text-auto-resize: false

      HelperListColumnSeparator
        id: friendPlayerSpellHeaderSeparator1
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 191

      Label
        id: friendPlayerSpellHeader1
        width: 100
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 194
        font: $var-cip-font
        color: #c0c0c0
        text-offset: 0 -1
        text-align: left
        text-auto-resize: false

      HelperListColumnSeparator
        id: friendPlayerSpellHeaderSeparator2
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 301

      Label
        id: friendPlayerSpellHeader2
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 304
        margin-right: 4
        font: $var-cip-font
        color: #c0c0c0
        text-offset: 0 -1
        text-align: left
        text-auto-resize: false

    Panel
      id: healFriendPlayerSettingsFrame
      anchors.top: healFriendPlayerSettingsHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: friendPlayerCountLabel.top
      margin-top: 3
      margin-left: 4
      margin-right: 4
      margin-bottom: 5
      image-source: /images/ui/1pixel-down-frame
      image-border: 3

      ScrollablePanel
        id: healFriendPlayerSettingsList
        vertical-scrollbar: healFriendPlayerSettingsScrollbar
        anchors.fill: parent
        padding: 1
        padding-right: 12
        background-color: alpha
        clipping: true
        layout:
          type: verticalBox
          spacing: 0

      VerticalQtScrollBar
        id: healFriendPlayerSettingsScrollbar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 36
        pixels-scroll: true
        margin: 1 1 1 0

      Label
        id: friendPlayerSettingsEmptyLabel
        height: 16
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        margin-right: 18
        font: $var-cip-font
        color: #909090
        text-align: center
        !text: tr('No party players.')
        phantom: true

    Label
      id: friendPlayerCountLabel
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 7
      margin-bottom: 8
      font: $var-cip-font
      color: #909090
      !text: tr('Party players: 0')
      text-auto-resize: true

  Panel
    id: activeHealFriendPanel
    width: 163
    height: 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 2

    OnePixelDownFrame
      id: enableHealFriendFrame
      width: 163
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      padding: 4

      OptionCheckBox
        id: enableHealFriendCheckBox
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        @onCheckChange: modules.game_helper.onEnableHealFriendChange(self, self:isChecked())

      Label
        !text: tr('Enable Heal Friend')
        font: $var-cip-font
        color: #c0c0c0
        anchors.top: parent.top
        anchors.left: parent.left
        text-offset: 16 -1

      UIWidget
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 1
        !tooltip: tr('Heal Friend:<br><li>Only confirmed party members are added automatically.</li><li>Players at the top have higher healing priority than players below. Drag a player up or down to reorder.</li><li>Only party members visible on the map can be healed.</li>')

HelperSectionTitle < Label
  font: $var-cip-font-new
