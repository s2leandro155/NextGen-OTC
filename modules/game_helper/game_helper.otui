PainelConfigs < Panel
  anchors.top: presetBar.bottom
  anchors.left: MainMenuLeft.right
  anchors.right: parent.right
  anchors.bottom: botSeparator.top
  margin-top: 5
  margin-left: 10
  margin-bottom: 10

  HelperPopupSection
    id: configsGeneralSection
    !text: tr('General Settings')
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    OnePixelDownFrame

      id: configsSharedHotkeyFrame
      height: 28
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      margin-left: 10
      margin-right: 10
      padding: 5

      Label
        id: configsSharedHotkeyLabel
        !text: tr('Target + Shooter Hotkey')
        height: 14
        font: $var-cip-font
        color: #c0c0c0
        anchors.left: parent.left
        anchors.right: configsSharedHotkeyButton.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 8
        text-align: left
        text-auto-resize: false

      Button
        id: configsSharedHotkeyButton
        !text: tr('Key [NONE]')
        size: 94 20
        anchors.right: configsSharedHotkeyHelp.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 8
        @onClick: modules.game_helper.openSharedCombatHotkeyWindow()

      UIWidget
        id: configsSharedHotkeyHelp
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        !tooltip: tr('Target + Shooter hotkey:<br><li>Assigns an independent key that toggles Target and Shooter together.</li><li>Does not change the individual hotkeys in either tab.</li><li>The key must be available; occupied keys cannot be overwritten.</li>')

    OnePixelDownFrame
      id: configsAutoSaveFrame
      height: 28
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 10
      margin-right: 10
      padding: 5

      OptionCheckBox
        id: configsAutoSaveCheckBox
        checked: true
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        @onCheckChange: modules.game_helper.onConfigsAutoSaveChange(self, self:isChecked())

      Label
        id: configsAutoSaveLabel
        !text: tr('Auto Save')
        height: 14
        font: $var-cip-font
        color: #c0c0c0
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 22
        margin-right: 20
        text-align: left
        text-auto-resize: false

      UIWidget
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        !tooltip: tr('Auto Save:<br><li>Saves every change automatically in the active profile.</li><li>When disabled, changes remain temporary until you use Save.</li>')

    OnePixelDownFrame
      id: configsAutoSwitchHotkeyPresetFrame
      height: 28
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 10
      margin-right: 10
      padding: 5

      OptionCheckBox
        id: configsAutoSwitchHotkeyPresetCheckBox
        checked: false
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        @onCheckChange: modules.game_helper.onConfigsAutoSwitchHotkeyPresetChange(self, self:isChecked())

      Label
        id: configsAutoSwitchHotkeyPresetLabel
        !text: tr('Auto-Switch Hotkey Preset')
        height: 14
        font: $var-cip-font
        color: #c0c0c0
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 22
        margin-right: 20
        text-align: left
        text-auto-resize: false

      UIWidget
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        !tooltip: tr('Auto-Switch Hotkey Preset:<br><li>On login, selects the client hotkey preset and Helper preset whose name exactly matches the character name.</li><li>All Helper tabs, profiles and hotkeys are always stored separately for each character.</li><li>If there is no matching preset, each system keeps its current preset.</li>')

// Janela do Helper
PainelCavebot < Panel
  anchors.top: presetBar.bottom
