      text: "Cavebot:"
      font: $var-cip-font
      color: #c0c0c0
      text-auto-resize: true
    Label
      id: cavebotToggleValue
      anchors.left: cavebotToggleTitle.right
      anchors.verticalCenter: cavebotToggleTitle.verticalCenter
      margin-left: 4
      text: "Off"
      font: $var-cip-font
      color: #ff3030
      text-auto-resize: true
    OptionCheckBox
      id: cavebotLoopCheckBox
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 450
      margin-top: 48
      checked: true
      @onCheckChange: modules.game_helper.onCavebotLoopChange(self:isChecked())
    fakeCheckBox
      id: cavebotRecordingCheckBox
      visible: false
      @onCheckChange: modules.game_helper.onCavebotRecordingChange(self:isChecked())
    Label
      id: cavebotHelperStatusValue
      visible: false
    Label
      id: cavebotWaypointCount
      visible: false

  OnePixelDownFrame
    id: cavebotStatusFrame
    height: 29
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Label
      id: cavebotStatus
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      text: State: STOPPED
      font: $var-cip-font
      color: #79aaff
      text-auto-resize: true
    Label
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      text: Route compatible
      font: $var-cip-font
      color: #75df75
      text-auto-resize: true

HelperWindow < MainLogoWindow
  id: helperWindow
  !text: tr('Helper')
  size: 620 511
  text-offset: -1 1
  clipping: false
  @onEscape: modules.game_helper.onHelperClose()
  @onSetup: |
    local logo = self:getChildById('logoBackdropCrest')
    if logo then
      logo:setMarginTop(-68)
      logo:raise()
    end

  // MENUS
  Panel
    id: MainMenuLeft
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: botSeparator.top
    width: 120
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    image-border: 5
    margin-top: -7
    margin-bottom: 10

    HelperMenuButtonFrame
      id: healingFrame
      anchors.top: parent.top
      margin-top: 7

      HelperSideMenuButton
        id: healing
        text: Healing
        icon: /modules/game_helper/images/icon-hitpoints
        icon-align: left
        icon-width: 12
        icon-height: 11
        icon-offset: 8 6
        @onClick: modules.game_helper.showTab('healing')

    HelperMenuButtonFrame
      id: healFriendFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: healFriend
        text: Heal Friend
        icon: /modules/game_helper/images/icon-healing
        icon-align: left
        icon-width: 11
        icon-height: 11
        icon-offset: 8 6
        @onClick: modules.game_helper.showTab('healFriend')

    HelperMenuButtonFrame
      id: targetButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: targetButton
        text: Target
        icon: /modules/game_helper/images/icon-battlelist
        icon-align: left
        icon-width: 12
        icon-height: 12
        icon-offset: 8 6
        @onClick: modules.game_helper.showTab('target')

    HelperMenuButtonFrame
      id: shooterButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: shooterButton
        text: Shooter
        icon: /modules/game_helper/images/icon-spellcaster
        icon-align: left
        icon-width: 9
        icon-height: 9
        icon-offset: 8 7
        @onClick: modules.game_helper.showTab('shooter')

    HelperMenuButtonFrame
      id: partyButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: partyButton
        text: Party
        icon: /modules/game_helper/images/icon-misc
        icon-align: left
        icon-width: 13
        icon-height: 13
        icon-offset: 8 7
        @onClick: modules.game_helper.showTab('party')

    HelperMenuButtonFrame
      id: toolsButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: toolsButton
        text: Tools
        icon: /modules/game_helper/images/icon-interface
        icon-align: left
        icon-width: 13
        icon-height: 10
        icon-offset: 8 7
        @onClick: modules.game_helper.showTab('tools')

    HelperMenuButtonFrame
      id: configsButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: configsButton
        text: Configs
        icon: /modules/game_helper/images/icon_options
        icon-align: left
        icon-width: 13
        icon-height: 13
        icon-offset: 8 5
        @onClick: modules.game_helper.showTab('configs')

    HelperMenuButtonFrame
      id: cavebotButtonFrame
      anchors.top: prev.bottom

      HelperSideMenuButton
        id: cavebotButton
        text: Cavebot
        icon: /modules/game_helper/images/icon-speed
        icon-align: left
        icon-width: 13
        icon-height: 13
        icon-offset: 8 6
        @onClick: modules.game_helper.showTab('cavebot')

    Panel
      id: helperCharacterCard
      anchors.top: cavebotButtonFrame.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 11
      margin-left: 7
      margin-right: 7
      margin-bottom: 8
      image-source: /images/ui/2pixel_up_frame_borderimage
      image-border: 5

      UICreature
        id: helperCharacterOutfit
        size: 64 64
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        fixed-creature-size: true
        base-scale: true
        creature-center: true
        ignore-displacement-shift: true
        phantom: true

      Label
        id: helperCharacterName
        height: 14
        anchors.top: helperCharacterOutfit.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #f0f0f0
        text: Offline
        text-align: center
        text-auto-resize: false
        clipping: true

      Label
        id: helperCharacterLevel
        height: 14
        anchors.top: helperCharacterName.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: $var-cip-font
        color: #c0c0c0
        text: "Level: -"
        text-align: center
        text-auto-resize: false

      HorizontalSeparator
        id: helperCharacterSeparator
        anchors.top: helperCharacterLevel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        margin-left: 5
        margin-right: 5

      Label
        id: helperAccountCaption
        height: 14
        anchors.top: helperCharacterSeparator.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 2
        margin-right: 2
        font: verdana-bold-8px-antialiased
        color: #c0c0c0
        text: "Account Status:"
        text-align: center
        text-auto-resize: false

      Panel
        id: helperAccountRow
        height: 36
        anchors.top: helperAccountCaption.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        margin-left: 0
        margin-right: 0

        Label
          id: helperAccountStatusIcon
          size: 22 20
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          image-source: /images/game/entergame/nopremium
          image-clip: 0 0 22 20

        Label
          id: helperAccountStatus
          height: 14
          anchors.top: helperAccountStatusIcon.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-left: 2
          margin-right: 2
          font: verdana-bold-8px-antialiased
          color: #c0c0c0
          text: Offline
          text-align: center
          text-auto-resize: false

      HelperMenuButton
        id: helperLanguageButton
        height: 22
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 5
        margin-right: 5
        margin-bottom: 6
        font: verdana-bold-8px-antialiased
        color: #c0c0c0
        text: English
        text-offset: 14 0
        @onClick: modules.game_helper.onHelperLanguageToggle()

        $pressed:
          text-offset: 15 1

        @onMousePress: |
          self.helperLanguageFlagEn:setMarginLeft(6)
          self.helperLanguageFlagEn:setMarginTop(1)
          self.helperLanguageFlagPt:setMarginLeft(6)
          self.helperLanguageFlagPt:setMarginTop(1)

        @onMouseRelease: |
          self.helperLanguageFlagEn:setMarginLeft(5)
          self.helperLanguageFlagEn:setMarginTop(0)
          self.helperLanguageFlagPt:setMarginLeft(5)
          self.helperLanguageFlagPt:setMarginTop(0)

        Panel
          id: helperLanguageFlagEn
          size: 18 12
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          background-color: #b22234
          border-width: 1
          border-color: #171717
          phantom: true

          UIWidget
            height: 1
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            background-color: #ffffff
            phantom: true

          UIWidget
            height: 1
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 4
            background-color: #ffffff
            phantom: true

          UIWidget
            height: 1
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6
            background-color: #ffffff
            phantom: true

          UIWidget
            height: 1
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 8
            background-color: #ffffff
            phantom: true

          UIWidget
            size: 7 6
            anchors.top: parent.top
            anchors.left: parent.left
            background-color: #3c3b6e
            phantom: true

        Panel
          id: helperLanguageFlagPt
          size: 18 12
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          image-source: /modules/game_helper/images/flag-brazil
          image-size: 18 12
          visible: false
          phantom: true


  Panel
    id: presetBar
    height: 26
    anchors.top: parent.top
    anchors.left: MainMenuLeft.right
    anchors.right: parent.right
    margin-top: -7
    margin-left: 10
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 5

    Label
      id: quickProfileLabel
      !text: tr('Preset:')
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: $var-cip-font
      color: #c0c0c0
      text-auto-resize: true

    QtComboBox
      id: quickProfileCombo
      height: 20
      anchors.left: quickProfileLabel.right
      anchors.right: quickProfileNewButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-right: 6
      menu-scroll: false
      menu-height: 126
      menu-scroll-step: 18

    HelperStdButton
      id: quickProfileNewButton
      width: 52
      anchors.right: quickProfileSaveButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      !text: tr('New')
      @onClick: modules.game_helper.onQuickProfileNew()

    HelperStdButton
      id: quickProfileSaveButton
      width: 52
      anchors.right: quickProfileDeleteButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      !text: tr('Save')
      @onClick: modules.game_helper.onQuickProfileSave()

    HelperStdButton
      id: quickProfileDeleteButton
      width: 52
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      !text: tr('Delete')
      @onClick: modules.game_helper.onQuickProfileDelete()

  // PAINEIS
  
  PainelHealing
    id: healingPanel
    visible: false
  PainelHealFriend
    id: healFriendPanel
    visible: false
  PainelTarget
    id: targetPanel
    visible: false
  PainelShooter
    id: shooterPanel
    visible: false
  PainelParty
    id: partyPanel
    visible: false
  PainelTools
    id: toolsPanel
    visible: false
  PainelConfigs
    id: configsPanel
    visible: false
  PainelCavebot
    id: cavebotPanel
    visible: false
  // Bottom Configuration Panel
  HorizontalSeparator
    id: botSeparator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 30
  
  OnePixelDownFrame
    id: activeHelperPanel
    width: 132
    height: 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    padding: 4
    
    OptionCheckBox
      id: checkbox
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      @onCheckChange: modules.game_helper.onEnableHelperChange(self, self:isChecked())

    Label
      !text: tr('Enable Helper')
      font: $var-cip-font
      color: #c0c0c0
      anchors.top: parent.top
      anchors.left: parent.left
      text-offset: 16 -1

    UIWidget
      id: toolTipWidget
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      !tooltip: tr('Check this box to activate the Helper.')

  Button
    id: setHotkeyButton
    anchors.left: activeHelperPanel.right
    anchors.bottom: parent.bottom
    size: 67 20
    margin-left: 6
    text: Key
    @onClick: modules.game_helper.openHelperHotkeyWindow()

  Button
    id: close
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text: Close
    size: 43 20
    @onClick: modules.game_helper.onHelperClose() 
