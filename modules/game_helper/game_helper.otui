    text-align: top
    text-offset: 1 2
    image-source: /images/ui/popupwindow-sem-borda-interna
    image-border: 6
    image-border-top: 27
    padding-top: 15
    focusable: false
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: activeHealFriendPanel.top
    margin-top: 15
    margin-left: 5
    margin-right: 5
    margin-bottom: 7

    Panel
      id: healFriendPlayerSettingsHeader
      height: 16
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 4
      margin-right: 4
      background-color: #363636

      Label
        id: friendPlayerEnabledHeader
        width: 18
        !text: tr('...')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
