HelperMainToggleButton < UIButton
  size: 20 20
  focusable: false
  image-source: /images/options/button_helper
  image-clip: 0 0 20 20

  $pressed:
    image-clip: 20 0 20 20

  $on:
    image-clip: 20 0 20 20

HelperMenuButton < Button
  $on:
    image-source: /images/ui/button-grey-down
    text-offset: 1 1

HelperMenuButtonFrame < OnePixelDownFrame
  size: 106 24
  padding: 1
  anchors.left: parent.left
  margin-left: 7
  margin-top: 11

HelperSideMenuButton < HelperMenuButton
  anchors.fill: parent
  height: 22
  color: #c0c0c0
  text-offset: 0 0

HelperActionSlot < ActionSlot
  visible: true
  draggable: false
  size: 34 34

HelperPostureButton < UIWidget
  size: 28 28
  phantom: false
  focusable: false

  UIWidget
    id: activeSpell
    anchors.fill: parent
    image-source: /assets/images/game/actionbar/border_activespell
    image-size: 28 28
    visible: false
    phantom: true
    focusable: false

HelperItemIconBackground < UIWidget
  phantom: true
  focusable: false
  size: 32 32
  image-size: 32 32
  image-source: /modules/game_helper/images/background-potions-foods

HelperRuneIconBackground < UIWidget
  phantom: true
  focusable: false
  size: 32 32
  image-size: 32 32
  image-source: /modules/game_helper/images/background-runes

HelperHealingActionSlot < HelperActionSlot
  HelperItemIconBackground
    id: healingActionItemBackground
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    visible: false

  UIItem
    id: healingActionItemIcon
    size: 32 32
    image-size: 32 32
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    virtual: true
    visible: false

HelperToolsActionSlot < HelperActionSlot
  anchors.verticalCenter: parent.verticalCenter

HelperTrainingItemSlot < UIWidget
  size: 34 34
  image-source: /images/game/actionbar/slot-actionbar-empty
  focusable: true

  UIWidget
    id: trainingSlotFrame
    anchors.centerIn: parent
    size: 34 34
    image-source: /images/game/actionbar/slot-actionbar-filled
    image-clip: 0 0 34 34
    visible: false

  HelperItemIconBackground
    id: trainingItemBackground
    anchors.centerIn: parent
    image-source: /modules/game_helper/images/background-exercises
    visible: false

  UIItem
    id: trainingItemIcon
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

HelperAmmoItemSlot < UIWidget
  size: 34 34
  image-source: /images/game/actionbar/slot-actionbar-empty
  focusable: true

  UIWidget
    id: ammoSlotFrame
    anchors.centerIn: parent
    size: 34 34
    image-source: /images/game/actionbar/slot-actionbar-filled
    image-clip: 0 0 34 34
    visible: false

  HelperItemIconBackground
    id: ammoItemBackground
    anchors.centerIn: parent
    image-source: /modules/game_helper/images/background-ammunition
    visible: false

  UIItem
    id: ammoItemIcon
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

HelperConditionsCheckBox < QtCheckBox
  size: 14 14
  anchors.verticalCenter: parent.verticalCenter
  anchors.left: parent.left
  margin-left: 4

PriorityTextEdit < TextEdit
  cursor-visible: false
  @onTextChange: modules.game_helper.autoSave()

HealFriendVocationThresholdPercent < Label
  text: %
  font: $var-cip-font
  color: #c0c0c0
  text-auto-resize: true
  phantom: true
  focusable: false

HealFriendClassCheckBox < QtCheckBox
  size: 14 14
  anchors.top: parent.top
  anchors.left: parent.left
  margin-left: 4

HelperListColumnSeparator < UIWidget
  phantom: true
  image-source: /images/ui/separator_vertical

HealFriendPlayerSettingsRow < Panel
  height: 36
  focusable: true
  background-color: #414141
  draggable: true

  UIWidget
    size: 23 36
    anchors.top: parent.top
    anchors.left: parent.left

    QtCheckBox
      id: friendPlayerEnabledCheckBox
      size: 14 14
      checked: true
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-left: -1

  HelperListColumnSeparator
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

  UICreature
    id: playerOutfit
    size: 32 32
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    phantom: true
    focusable: false

  Label
    id: playerName
    width: 125
    anchors.left: playerOutfit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: $var-cip-font-new
    color: #c0c0c0
    clipping: true
    phantom: true
    focusable: false

HealFriendPlayerDragGhost < Panel
  height: 36
  width: 260
  background-color: #585858
  border-width: 1
  border-color: #808080
  opacity: 0.92
  phantom: true
  focusable: false
  draggable: false

  UICreature
    id: playerOutfit
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    phantom: true
    focusable: false

  Label
    id: playerName
    anchors.left: playerOutfit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: $var-cip-font-new
    color: #ffffff
    text-auto-resize: true
    phantom: true
    focusable: false

  Label
    !text: tr('Higher priority')
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    font: $var-cip-font
    color: #c0c0c0
    text-auto-resize: true
    phantom: true
    focusable: false

HelperPriorityQtyButton < UIButton
  size: 16 16
  image-source: /game_rewardwall/images/buttons_pick_rewards
  image-size: 16 16
  image-auto-resize: false
  focusable: false

HelperPriorityQtyButtonBackOne < HelperPriorityQtyButton
  image-clip: 0 48 16 16
  $disabled:
    image-clip: 0 16 16 16
  $hover !disabled:
    image-clip: 0 48 16 16
  $pressed:
    image-clip: 0 80 16 16

HelperPriorityQtyButtonForwardOne < HelperPriorityQtyButton
  image-clip: 16 48 16 16
  $disabled:
    image-clip: 16 16 16 16
  $hover !disabled:
    image-clip: 16 48 16 16
  $pressed:
    image-clip: 16 80 16 16

HealFriendPriorityStepper < Panel
  size: 58 17
  focusable: false
  phantom: true

  HelperPriorityQtyButtonBackOne
    id: btnDec
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    @onClick: modules.game_helper.onHealFriendPriorityClick(self, 'dec')

  UIWidget
    id: numberBox
    size: 20 17
    anchors.left: btnDec.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    background-color: #2a2a2aff
    border-width-top: 1
    border-width-left: 1
    border-width-right: 1
    border-width-bottom: 1
    border-color-bottom: #808080
    border-color-right: #808080
    border-color-left: #131313
    border-color-top: #131313

    Label
      id: numberValue
      anchors.fill: parent
      font: $var-cip-font-new
      color: #FFFFFF
      text-align: center
      text: 0
      phantom: true
      focusable: false

  HelperPriorityQtyButtonForwardOne
    id: btnInc
    anchors.left: numberBox.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    @onClick: modules.game_helper.onHealFriendPriorityClick(self, 'inc')

HelperShooterPriorityStepper < Panel
  size: 58 17
  focusable: false
  phantom: true

  HelperPriorityQtyButtonBackOne
    id: btnDec
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    @onClick: modules.game_helper.onShooterPriorityClick(self, 'dec')

  UIWidget
    id: numberBox
    size: 20 17
    anchors.left: btnDec.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    background-color: #2a2a2aff
    border-width-top: 1
    border-width-left: 1
    border-width-right: 1
    border-width-bottom: 1
    border-color-bottom: #808080
    border-color-right: #808080
    border-color-left: #131313
    border-color-top: #131313

    Label
      id: numberValue
      anchors.fill: parent
      font: $var-cip-font-new
      color: #FFFFFF
      text-align: center
      text: 0
      phantom: true
      focusable: false

  HelperPriorityQtyButtonForwardOne
    id: btnInc
    anchors.left: numberBox.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    @onClick: modules.game_helper.onShooterPriorityClick(self, 'inc')

ProfileListItem < Panel
  height: 18
  focusable: true

  Label
    id: itemLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-top: 2
    font: $var-cip-font
    color: #c0c0c0
    text-auto-resize: false
    phantom: true

ProfileListItemOdd < ProfileListItem
  background-color: #484848

  $focus:
    background-color: #585858

  $!focus:
    background-color: #484848

ProfileListItemEven < ProfileListItem
  background-color: #414141

  $focus:
    background-color: #585858

  $!focus:
    background-color: #414141

HelperStatsToggleRow < Panel
  height: 31
  focusable: true

  $hover:
    background-color: #ffffff12

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -2
    margin-left: 0
    height: 14
    font: $var-cip-font-new
    color: #f0f0f0
    text-auto-resize: true
    phantom: true

  UIWidget
    id: statusIcon
    size: 12 9
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    margin-top: 3
    margin-left: 1
    image-source: /images/icons/icon-no
    phantom: true

  Label
    id: statusLabel
    anchors.top: titleLabel.bottom
    anchors.left: statusIcon.right
    margin-top: 1
    margin-left: 4
    height: 14
    font: $var-cip-font-new
    color: #ff3030
    text: Disabled
    text-auto-resize: true
    phantom: true

HelperStatsWindow < MiniWindow
  id: helperStatsWindow
  height: 285
  &save: true
  &moveOnlyToSideBars: true

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-helper
    image-size: 12 12
    phantom: true
    image-smooth: true

  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Helper Stats')
    color: #909090

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-right: 1
    margin-bottom: 5
    vertical-scrollbar: miniwindowScrollBar

    Panel
      id: helperStatsRows
      width: 150
      anchors.top: parent.top
      anchors.left: parent.left
      layout:
        type: verticalBox
        fit-children: true

      Button
        id: helperStatsOpenHelperButton
        size: 118 20
        margin-top: 1
        margin-bottom: 4
        margin-left: 16
        !text: tr('Open Helper')
        text-offset: 0 0

      HelperStatsToggleRow
        id: helperStatsHealingRow

      HelperStatsToggleRow
        id: helperStatsHealFriendRow

      HelperStatsToggleRow
        id: helperStatsTargetRow

      HelperStatsToggleRow
        id: helperStatsShooterRow

      HelperStatsToggleRow
        id: helperStatsAutoInviteRow

      HelperStatsToggleRow
        id: helperStatsAutoAcceptRow

      HelperStatsToggleRow
        id: helperStatsAutoHasteRow

      HelperStatsToggleRow
        id: helperStatsAutoTrainingRow

      HelperStatsToggleRow
        id: helperStatsAntiIdleRow

      HelperStatsToggleRow
        id: helperStatsManaTrainingRow

      HelperStatsToggleRow
        id: helperStatsChangeGoldRow

      HelperStatsToggleRow
        id: helperStatsEatFoodRow

      HelperStatsToggleRow
        id: helperStatsReconnectRow

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 80
    maximum: 456
    margin-left: 3
    margin-right: 3

HelperPopupSection < Panel
  color: $var-text-color-disabled
  font: $var-cip-font-new
  text-offset: 1 2
  text-align: top
  image-source: /images/ui/popupwindow-sem-borda-interna
  image-border: 6
  image-border-top: 27
  padding: 15 7 7 7

HelperSectionHelpIcon < UIWidget
  image-source: /images/icons/show_gui_help_grey
  size: 12 12
  focusable: false
  margin-top: 3
  margin-right: 3
  @onSetup: self:raise()

PainelHealing < Panel
  anchors.top: presetBar.bottom
  anchors.left: MainMenuLeft.right
  anchors.right: parent.right
  anchors.bottom: botSeparator.top
  margin-top: 5
  margin-left: 10
  margin-bottom: 10

  HelperPopupSection
    id: healingSection
    !text: tr('Healing')
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Panel
      id: activeHealingPanel
      width: 132
      height: 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right

      OnePixelDownFrame
        id: enableHealingFrame
        width: 122
        height: 20
        anchors.top: parent.top
        anchors.left: parent.left
        padding: 4

        OptionCheckBox
          id: enableHealingCheckBox
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          @onCheckChange: modules.game_helper.onEnableHealingChange(self, self:isChecked())

        Label
          !text: tr('Enable Healing')
          font: $var-cip-font
          color: #c0c0c0
          anchors.top: parent.top
          anchors.left: parent.left
          text-offset: 16 -1

    Panel
      id: healingGroupsPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: activeHealingPanel.top
      margin-top: 7
      margin-bottom: 6

      VerticalSeparator
        id: healingGroupsSeparator
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter

      Panel
        id: healingSpellPanel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: healingGroupsSeparator.left
        anchors.bottom: parent.bottom
        margin-right: 6

        Label
          !text: tr('Spell Healing')
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 1
          margin-top: 2
          font: $var-cip-font-new
          color: #c0c0c0
          text-auto-resize: true

        OnePixelDownFrame
          id: healingSpellListFrame
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: addHealingSpellButton.top
          margin-top: 20
          margin-bottom: 6
          padding: 1

          ScrollablePanel
            id: healingSpellEntriesPanel
            anchors.fill: parent
            margin-right: 12
            padding-top: 17
            vertical-scrollbar: healingSpellScrollBar
            background-color: #404040
            clipping: true
            layout:
              type: verticalBox
              spacing: 0

          VerticalQtScrollBar
            id: healingSpellScrollBar
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.right: parent.right
            step: 50
            pixels-scroll: true

          HealingListHeader
            id: healingSpellListHeader
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-left: 1
            margin-top: 0
            margin-right: 12
            @onSetup: self:raise()

          HorizontalSeparator
            anchors.top: healingSpellListHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: -1
            margin-right: 12
            @onSetup: self:raise()

        CipsoftButton
          id: addHealingSpellButton
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          size: 72 20
          text: Add Spell
          text-offset: 0 1
          @onClick: modules.game_helper.openAddHealingSpellWindow()

      Panel
        id: healingPotionPanel
        anchors.top: parent.top
        anchors.left: healingGroupsSeparator.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 6

        Label
          !text: tr('Potion Healing')
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 1
          margin-top: 2
          font: $var-cip-font-new
          color: #c0c0c0
          text-auto-resize: true

        OnePixelDownFrame
          id: healingPotionListFrame
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: addHealingPotionButton.top
          margin-top: 20
          margin-bottom: 6
          padding: 1

          ScrollablePanel
            id: healingPotionEntriesPanel
            anchors.fill: parent
            margin-right: 12
            padding-top: 17
            vertical-scrollbar: healingPotionScrollBar
            background-color: #404040
            clipping: true
            layout:
              type: verticalBox
              spacing: 0

          VerticalQtScrollBar
            id: healingPotionScrollBar
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.right: parent.right
            step: 50
            pixels-scroll: true

          HealingListHeader
            id: healingPotionListHeader
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-left: 1
            margin-top: 0
            margin-right: 12
            @onSetup: self:raise()

          HorizontalSeparator
            anchors.top: healingPotionListHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: -1
            margin-right: 12
            @onSetup: self:raise()

        CipsoftButton
          id: addHealingPotionButton
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          size: 76 20
          text: Add Potion
          text-offset: 0 1
          @onClick: modules.game_helper.openAddHealingPotionWindow()

  HelperSectionHelpIcon
    id: healingPriorityHelp
    anchors.top: healingSection.top
    anchors.right: healingSection.right
    !tooltip: tr('Healing actions are checked by their configured HP/MP percent, not by their visual position.')

PainelHealFriend < Panel
  anchors.top: presetBar.bottom
  anchors.left: MainMenuLeft.right
  anchors.right: parent.right
  anchors.bottom: botSeparator.top
  font: $var-cip-font-new
  color: #929292
  text-offset: 0 2
  text-align: top
  !text: tr('Heal Friend')
  margin-top: 5
  margin-left: 10
  margin-bottom: 10
  image-source: /images/ui/popupwindow-sem-borda-interna
  image-border: 20
  padding: 7

  Panel
    id: mainPanel1
    text: Exura Sio
    color: $var-text-color-disabled
    font: $var-cip-font-new
    text-align: top
    text-offset: 1 2
    image-source: /images/ui/popupwindow-sem-borda-interna
    image-border: 6
    image-border-top: 27
    padding-top: 15
    focusable: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    margin-left: 5
    margin-right: 5
    height: 130

    UIWidget
      id: exuraSioWidget
      size: 34 34
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 45
      margin-right: 33
      image-source: /modules/game_helper/images/heal-friend
      image-clip: 0 0 34 34
      !tooltip: tr("Action: Cast Heal Friend\nFormula: exura sio\nCooldown: 1s\nMana: 120")

    Panel
      id: friendHeaderRow1
      height: 18
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 4
      margin-right: 4

      Label
        !text: tr('When HP')
        font: $var-cip-font
        color: #c0c0c0
        text-auto-resize: true
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left

      QtComboBox
        id: friendConditionComboBox1
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 5
        size: 42 17
        @onSetup: |
          self:addOption('<')
          self:addOption('<=')
          self:setCurrentOption('<')
        @onOptionChange: modules.game_helper.onHealFriendClassToggle(self)

      PriorityTextEdit
        id: friendThresholdEdit1
        visible: false
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 5
        color: #FFFFFF
        font: $var-cip-font-new
        text-align: left
        !text: 80
        max-length: 3
        size: 28 17
        @onTextChange: modules.game_helper.onHealFriendThresholdChange(self)
        @onFocusChange: modules.game_helper.onHealFriendThresholdFocusChange(self, self:isFocused())

      Label
        text: %
        visible: false
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 3

    Panel
      id: sioKnightPanel1
      width: 200
      height: 20
      anchors.top: friendHeaderRow1.bottom
      anchors.left: parent.left
      margin-top: 3
      margin-left: 2
      
      HealFriendClassCheckBox
        id: enableHealFriendKnightCheckBox1
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        @onCheckChange: modules.game_helper.onHealFriendClassToggle(self)

      Label
        !text: tr('Knight')
        font: $var-cip-font
        color: #c0c0c0
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 19
        text-align: center
      
      Label
        !text: tr('Priority: ')
        font: $var-cip-font
        color: #c0c0c0
        anchors.top: parent.top
        anchors.left: prev.right
        text-align: center
        margin-left: 25

      HealFriendPriorityStepper
        anchors.top: parent.top
        anchors.left: prev.right
        margin-left: 5
        @onSetup: |
          modules.game_helper.setupHealFriendPriorityStepper(self, 'priorityKnightEdit1', 5)

    Panel
      id: sioPaladinPanel1
      width: 200
      height: 20
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 2
      
      HealFriendClassCheckBox
        id: enableHealFriendPaladinCheckBox1
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        @onCheckChange: modules.game_helper.onHealFriendClassToggle(self)

      Label
        !text: tr('Paladin')
        font: $var-cip-font
        color: #c0c0c0
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 19
        text-align: center
      
      Label
        !text: tr('Priority: ')
        font: $var-cip-font
        color: #c0c0c0
        anchors.top: parent.top
        anchors.left: prev.right
        text-align: center
        margin-left: 19
      
      HealFriendPriorityStepper
        anchors.top: parent.top
        anchors.left: prev.right
        margin-left: 5
        @onSetup: |
          modules.game_helper.setupHealFriendPriorityStepper(self, 'priorityPaladinEdit1', 4)

    Panel
      id: sioSorcererPanel1
      width: 200
      height: 20
      anchors.top: prev.bottom
