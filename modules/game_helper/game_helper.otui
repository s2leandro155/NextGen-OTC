    anchors.right: autoInviteSection.right
    !tooltip: tr('Auto Invite:<br><li>Uses only the invite list above.</li><li>When enabled, the helper invites configured players when they are nearby and not already in party.</li><li>Fill up to four player names.</li>')

  HelperPopupSection
    id: autoAcceptSection
