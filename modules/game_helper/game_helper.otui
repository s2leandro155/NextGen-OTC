  margin-bottom: 5

PainelTarget < Panel
  anchors.top: presetBar.bottom
  anchors.left: MainMenuLeft.right
  anchors.right: parent.right
  anchors.bottom: botSeparator.top
  margin-top: 5
  margin-left: 10
  margin-bottom: 10

  Panel
    id: targetContentArea
    size: 459 417
    anchors.top: parent.top
    anchors.left: parent.left

  HelperPopupSection
    id: targetListWindow
    !text: tr('Target List')
    height: 243
    anchors.top: targetContentArea.top
    anchors.left: targetContentArea.left
    anchors.right: targetContentArea.right

    Panel
      id: targetListButtonsRow
      height: 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 2

      HelperStdButton
        id: targetRemoveBtn
        anchors.top: parent.top
        anchors.right: parent.right
        size: 58 20
        !text: tr('Remove')
        visible: false
        @onClick: modules.game_helper.onTargetRemoveClick()

      HelperStdButton
        id: targetEditBtn
        anchors.top: parent.top
        anchors.right: targetRemoveBtn.left
        margin-right: 6
        !text: tr('Edit')
        visible: false
        @onClick: modules.game_helper.openTargetEditWindow()

      HelperStdButton
        id: targetAddBtn
        anchors.top: parent.top
        anchors.right: parent.right
        size: 58 20
        !text: tr('Add')
        @onClick: modules.game_helper.openTargetAssignWindow()

    OnePixelDownFrame
      id: targetListFrame
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: targetListButtonsRow.top
      margin-top: 7
      margin-bottom: 6
      padding: 1

      ScrollablePanel
        id: targetPriorityList
        anchors.fill: parent
        vertical-scrollbar: targetPriorityListScrollbar
        padding-top: 17
        background-color: #414141
        clipping: true
        layout:
          type: verticalBox
          spacing: 0

      VerticalQtScrollBar
        id: targetPriorityListScrollbar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 34
        pixels-scroll: true

      TargetPriorityListHeader
        id: targetPriorityListHeader
        height: 16
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-right: 12
        @onSetup: self:raise()

      HorizontalSeparator
        anchors.top: targetPriorityListHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: -1
        margin-right: 12
        @onSetup: self:raise()

  HelperSectionHelpIcon
    id: targetListHelp
    anchors.top: targetListWindow.top
    anchors.right: targetListWindow.right
    !tooltip: tr('The order of entries in the list is the primary targeting priority. Entries at the top are preferred first.<br><br><li>Right-click an entry to open a menu and change its order in the list.</li><li>Uncheck an entry to temporarily disable that target entry without removing it.</li>')

  HelperPopupSection
    id: targetSettingsWindow
    !text: tr('Target Settings')
    height: 142
    anchors.top: targetListWindow.bottom
    anchors.left: targetContentArea.left
    anchors.right: targetContentArea.right
    margin-top: 10

    Panel
      id: targetModeRow
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: -2

      Label
        id: targetModeLabel
        width: 70
        !text: tr('Mode:')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: false

      QtComboBox
        id: targetModeCombo
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 108 17
        @onOptionChange: modules.game_helper.onTargetModeChange(self)

    Panel
      id: targetMinDistRow
      height: 20
      anchors.top: targetModeRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: -2

      Label
        id: targetDistanceLabel
        width: 70
        !text: tr('Distance:')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: false

      QtComboBox
        id: targetDistanceCombo
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 108 17
        @onOptionChange: modules.game_helper.onTargetDistanceChange(self)

    Panel
      id: targetPriorityRow
      height: 20
      anchors.top: targetMinDistRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: -2

      Label
        id: targetPriorityLabel
        width: 70
        !text: tr('Priority:')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: false

      QtComboBox
        id: targetOperatingModeCombo
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 170 17
        text-align: left
        text-offset: 5 0
        menu-scroll: true
        menu-height: 72
        menu-scroll-step: 16
        @onOptionChange: modules.game_helper.onTargetPriorityChange(self)

        $pressed !disabled:
          text-offset: 5 1

        $on:
          text-offset: 5 1

    Panel
      id: targetPzAutoRow
      height: 20
      anchors.top: targetPriorityRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: -2

      Label
        id: targetPzAutoLabel
        width: 70
        !text: tr('PZ Auto:')
        !tooltip: tr('PZ Auto:<br><li>Enabled: pauses Target inside a protection zone and restores it after leaving.</li><li>Disabled: turns Target off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li>')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: false

      QtComboBox
        id: targetPzAutoCombo
        !tooltip: tr('PZ Auto:<br><li>Enabled: pauses Target inside a protection zone and restores it after leaving.</li><li>Disabled: turns Target off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li>')
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 108 17
        @onOptionChange: modules.game_helper.onTargetPzAutoChange(self)

    Panel
      id: activeTargetPanel
      height: 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right


      OnePixelDownFrame
        id: enableTargetFrame
        width: 122
        height: 20
        anchors.top: parent.top
        anchors.left: parent.left
        padding: 4

        OptionCheckBox
          id: enableTargetCheckBox
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          @onCheckChange: modules.game_helper.onEnableTargetChange(self, self:isChecked())

        Label
          id: enableTargetLabel
          !text: tr('Enable Target')
          font: $var-cip-font
          color: #c0c0c0
          anchors.top: parent.top
          anchors.left: parent.left
          text-offset: 16 -1

      Button
        id: setTargetHotkeyButton
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: enableTargetFrame.right
        size: 67 20
        margin-left: 6
        text: Key [NONE]
        @onClick: modules.game_helper.openTargetHotkeyWindow()

  HelperSectionHelpIcon
    id: targetSettingsHelp
    anchors.top: targetSettingsWindow.top
    anchors.right: targetSettingsWindow.right
    !tooltip: tr('Settings applied when auto-targeting is enabled:<br><li>Mode: Stand keeps your character in place; Chase makes your character follow the target.</li><li>Distance: Minimum and maximum distance in tiles between you and a creature for it to be auto-targeted.</li><li>PZ Auto enabled: pauses auto-target inside a protection zone and restores it after leaving.</li><li>PZ Auto disabled: turns auto-target off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li><br>Priority:<br><li>Best Target: chooses the creature that would let an area attack hit the most monsters. This is mainly intended for paladins using diamond arrows.</li><li>Ascending: chooses by the primary parameter selected in \"by\", from lowest to highest, then uses the secondary parameter selected in \"and\" when needed.</li><li>Descending: chooses by the primary parameter selected in \"by\", from highest to lowest, then uses the secondary parameter selected in \"and\" when needed.</li>')

PainelShooter < Panel
  anchors.top: presetBar.bottom
  anchors.left: MainMenuLeft.right
  anchors.right: parent.right
  anchors.bottom: botSeparator.top
  margin-top: 5
  margin-left: 10
  margin-bottom: 10

  Panel
    id: shooterContentArea
    size: 459 417
    anchors.top: parent.top
    anchors.left: parent.left

  HelperPopupSection
    id: shooterListWindow
    !text: tr('Shooter List')
    height: 287
    anchors.top: shooterContentArea.top
    anchors.left: shooterContentArea.left
    anchors.right: shooterContentArea.right

    Panel
      id: shooterListButtonsRow
      height: 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 2

      HelperStdButton
        id: shooterRemoveBtn
        anchors.top: parent.top
        anchors.right: parent.right
        size: 58 20
        !text: tr('Remove')
        visible: false
        @onClick: modules.game_helper.onShooterRemoveClick()

      HelperStdButton
        id: shooterEditBtn
        anchors.top: parent.top
        anchors.right: shooterRemoveBtn.left
        margin-right: 6
        !text: tr('Edit')
        visible: false
        @onClick: modules.game_helper.openShooterEditWindow()

      HelperStdButton
        id: shooterAddBtn
        anchors.top: parent.top
        anchors.right: parent.right
        size: 58 20
        !text: tr('Add')
        @onClick: modules.game_helper.openShooterAssignWindow()

    OnePixelDownFrame
      id: shooterListFrame
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: shooterListButtonsRow.top
      margin-top: 7
      margin-bottom: 6
      padding: 1

      ScrollablePanel
        id: shooterPriorityList
        vertical-scrollbar: shooterPriorityListScrollbar
        anchors.fill: parent
        padding-top: 17
        background-color: #414141
        clipping: true
        layout:
          type: verticalBox
          spacing: 0

      VerticalQtScrollBar
        id: shooterPriorityListScrollbar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 34
        pixels-scroll: true

      ShooterPriorityListHeader
        id: shooterPriorityListHeader
        height: 16
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-right: 12
        @onSetup: self:raise()

      HorizontalSeparator
        anchors.top: shooterPriorityListHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: -1
        margin-right: 12
        @onSetup: self:raise()

  HelperSectionHelpIcon
    id: shooterListHelp
    anchors.top: shooterListWindow.top
    anchors.right: shooterListWindow.right
    !tooltip: tr('The order of entries in the list determines the shooter priority. Entries at the top are checked first.<br><br><li>Drag an entry up or down to reorder it.</li><li>Right-click an entry to open a menu and change its order in the list.</li><li>Uncheck an entry to temporarily disable that spell or rune without removing it.</li>')

  HelperPopupSection
    id: shooterControlWindow
    !text: tr('Shooter Settings')
    height: 98
    anchors.top: shooterListWindow.bottom
    anchors.left: shooterContentArea.left
    anchors.right: shooterContentArea.right
    margin-top: 10

    Panel
      id: shooterPresetsPanel
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: -2

      Label
        id: shooterPresetsLabel
        width: 70
        !text: tr('Presets:')
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        font: $var-cip-font
        color: #c0c0c0
        text-auto-resize: false

      QtComboBox
        id: shooterPresets
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 108 17
        color: #c0c0c0
        @onOptionChange: modules.game_helper.onShooterPresetChange(self)
        @onMousePress: |
          return modules.game_helper.onShooterPresetMenu(self)

      HelperStdButton
        id: shooterRenamePresetBtn
        anchors.top: parent.top
        anchors.left: prev.right
        margin-left: 6
        margin-top: 1
        text-offset: 0 -1
        size: 58 17
        !text: tr('Rename')
        @onClick: modules.game_helper.onShooterRenamePreset()

      HelperStdButton
        id: shooterNewPresetBtn
        anchors.top: shooterRenamePresetBtn.top
        anchors.left: shooterRenamePresetBtn.right
        margin-left: 6
        text-offset: 0 -1
        size: 43 17
        !text: tr('New')
        @onClick: modules.game_helper.onShooterNewPreset()

      HelperStdButton
        id: shooterRemovePresetBtn
        anchors.top: shooterNewPresetBtn.top
        anchors.left: shooterNewPresetBtn.right
        margin-left: 6
        text-offset: 0 -1
        size: 58 17
        !text: tr('Remove')
        @onClick: modules.game_helper.onShooterRemovePreset()

    Panel
      id: shooterPzAutoRow
      height: 20
      anchors.top: shooterPresetsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: -2

      Label
        id: shooterPzAutoLabel
        width: 70
        !text: tr('PZ Auto:')
        !tooltip: tr('PZ Auto:<br><li>Enabled: pauses Shooter inside a protection zone and restores it after leaving.</li><li>Disabled: turns Shooter off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li>')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: false

      QtComboBox
        id: shooterPzAutoCombo
        !tooltip: tr('PZ Auto:<br><li>Enabled: pauses Shooter inside a protection zone and restores it after leaving.</li><li>Disabled: turns Shooter off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li>')
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        size: 108 17
        @onOptionChange: modules.game_helper.onShooterPzAutoChange(self)

      Panel
        id: comboModeUnit
        width: 140
        height: 20
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: shooterPzAutoCombo.right
        margin-left: 14

        OptionCheckBox
          id: enableComboModeCheckBox
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          !tooltip: tr('Combo priority: when enabled, casts your enabled spells as a rotating combo (round-robin), reading the list from top to bottom, instead of always repeating the highest-priority ready spell.')
          @onCheckChange: modules.game_helper.onShooterComboModeChange(self, self:isChecked())

        Label
          id: comboModeLabel
          !text: tr('Combo priority')
          font: $var-cip-font
          color: #c0c0c0
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 18 0
          text-auto-resize: true
          phantom: true

    Panel
      id: activeShooterPanel
      height: 28
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right

      OnePixelDownFrame
        id: enableShooterFrame
        width: 122
        height: 20
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        padding: 4

        OptionCheckBox
          id: enableShooterCheckBox
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          @onCheckChange: modules.game_helper.onEnableShooterChange(self, self:isChecked())

        Label
          id: enableShooterLabel
          !text: tr('Enable Shooter')
          font: $var-cip-font
          color: #c0c0c0
          anchors.top: parent.top
          anchors.left: parent.left
          text-offset: 16 -1

      Button
        id: setShooterHotkeyButton
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: enableShooterFrame.right
        size: 67 20
        margin-left: 6
        text: Key [NONE]
        @onClick: modules.game_helper.openShooterEnableHotkeyWindow()

      Label
        id: postureLabel
        width: 58
        !text: tr('Posture:')
        font: $var-cip-font
        color: #c0c0c0
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: setShooterHotkeyButton.right
        margin-left: 12
        text-auto-resize: false

      Panel
        id: posturePanel
        height: 28
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: postureLabel.right
        anchors.right: parent.right
        margin-left: 8
        layout:
          type: horizontalBox
          spacing: 4

  HelperSectionHelpIcon
    id: shooterSettingsHelp
    anchors.top: shooterControlWindow.top
    anchors.right: shooterControlWindow.right
    !tooltip: tr('Shooter settings:<br><li>Presets save independent shooter lists.</li><li>Use the pencil beside a preset to assign a hotkey that selects it.</li><li>PZ Auto enabled: pauses Shooter inside a protection zone and restores it after leaving.</li><li>PZ Auto disabled: turns Shooter off in a protection zone. It stays off after leaving and cannot be enabled while you are inside.</li>')

