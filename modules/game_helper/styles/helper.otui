HelperPostureButton < UIWidget
  size: 28 28
  phantom: false
  focusable: false

  UIWidget
    id: activeSpell
    anchors.fill: parent
    image-source: /assets/images/game/actionbar/border_activespell
    image-size: 28 28
    visible: false
    phantom: true
    focusable: false

HelperTracker < MiniWindow
  id: helperMiniWindow
  !text: tr('Helper Stats')
  height: 145
  &type: 'helper'

  UIWidget
    id: helperIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 4
    margin-left: 4
    size: 9 9
    image-source: /images/icons/icon-healing
    phantom: true

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: helperIcon.right
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 3
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    color: #9d9d9dff
    !text: tr('Helper Stats')

  MiniWindowContents
    id: contentsPanel
    anchors.fill: parent
    margin: 20 9 5 9
    Label
      id: helperLabel
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Helper Stats')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: helperStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: Verdana Bold-11px
      color: #D33C3C
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: targetLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Target Helper')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: targetStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: Verdana Bold-11px
      color: #D33C3C
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: shooterLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Shooter Helper')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: shooterStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: Verdana Bold-11px
      color: #D33C3C
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: currentPresetLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Shooter Preset')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: currentPresetName
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('No data yet')
      margin-top: -3
      margin-left: 5
      font: Verdana Bold-11px
      color: #44ad25
      text-auto-resize: true
      tooltip-delayed: true

    Button
      id: openHelper
      size: 108 20
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Open Helper')
      margin-top: 5
      margin-left: 24
      @onClick: modules.game_helper.toggle()

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2
  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 155
    maximum: 155
    margin-left: 3
    margin-right: 3

HelperRules < NewHeadlessWindow
  id: helperRules
  anchors.horizontalCenter: parent.horizontalCenter
  size: 450 345
  @onEscape: hide()
  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -33
    image-source: /images/game/tutorial/backdrop_crest
    phantom: true

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 15 13 17 13
    TextList
      id: rules
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: separator.top
      margin-top: 10
      margin-bottom: 10
      text-align: center
      padding: 1
      focusable: false
      background-color: #484848
    
    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 10
    Button
      id: next
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Next')
      size: 43 20
      enabled: false
      @onClick: modules.game_helper:onHelperTermConditionNext()
    Button
      id: close
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 5
      !text: tr('Close')
      size: 43 20
      @onClick: modules.game_helper.closeTerms()
    CheckBox
      id: termCondition
      width: 100
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      text-offset: 16 -2
      !text: tr('I agree with RubinOT Terms and Conditions.')
      !tooltip: tr('I have read and I agree to the Extended RubinOT Service Agreement and the RubinOT Privacy Policy.')
      margin-bottom: 5
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
      @onCheckChange: modules.game_helper.onHelperTermCondition(self:getId(), self:isChecked())

PlayerName < Label
  focusable: true
  height: 15
  font: Verdana Bold-11px
  color: #909090

  $focus:
    background-color: #484848
    color: #f4f4f4
  $!focus:
    background-color: alpha
    color: #c0c0c0

PotionItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

RuneItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

HealSlotButton < UIButton
  size: 34 34
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  image-source: /images/game/actionbar/actionbarslot

HealMinusButton < UIButton
  size: 10 24
  anchors.verticalCenter: parent.verticalCenter
  image-source: /images/ui/percent-buttons
  image-clip: 0 0 10 24
  $hover !pressed:
    image-clip: 0 0 10 24
  $pressed:
    image-clip: 0 24 10 24
  $disabled:
    image-clip: 0 48 10 24

HealPlusButton < UIButton
  size: 10 24
  anchors.verticalCenter: parent.verticalCenter
  image-source: /images/ui/percent-buttons
  image-clip: 10 0 10 24
  $hover !pressed:
    image-clip: 10 0 10 24
  $pressed:
    image-clip: 10 24 10 24
  $disabled:
    image-clip: 10 48 10 24

HealPercentBg < FlatPanel
  size: 42 24
  anchors.verticalCenter: parent.verticalCenter
  image-source: /images/ui/percentBg

HealPriorityButton < UIButton
  size: 12 12
  anchors.verticalCenter: parent.verticalCenter
  image-source: /images/skin/show-gui-help-grey

HealSpellSlot < Panel
  width: 86
  height: 62
  anchors.top: parent.top

HealPotionSlot < Panel
  width: 86
  height: 62
  anchors.top: parent.top

