          anchors.verticalCenter: combatStanceButton0.verticalCenter
          anchors.left: prev.right
          margin-left: 2
          !tooltip: tr('Mana Percent')
          Label
            id: combatStancePercentLabel
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            !text: tr('0%%')
            font: Verdana Bold-11px
            color: #c0c0c0
            text-auto-resize: true
            phantom: true
        UIButton
          id: combatStanceAddPercent
          size: 10 24
          anchors.verticalCenter: combatStanceButton0.verticalCenter
          anchors.left: prev.right
          margin-left: 2
          image-source: /images/ui/percent-buttons
          image-clip: 10 0 10 24
          @onSetup: |
            g_mouse.bindAutoPress(self, function() updateCombatStancePercent(self:getId()) end, 150)
          $hover !pressed:
            image-clip: 10 0 10 24
          $pressed:
            image-clip: 10 24 10 24
          $disabled:
            image-clip: 10 48 10 24
  Panel
    id: enableButtons
    height: 65
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 10
    padding: 3
    CheckBox
      id: enableAutoTarget
      width: 90
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Auto Target')
      margin-left: 2
      margin-top: 7
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 13 -3
      @onCheckChange: toggleAutoTarget(self)
      change-cursor-image: false
      $hover !disabled:
      color: #c0c0c0
    ComboBox
      id: autoTargetMode
      size: 50 15
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 7
      margin-top: -3
      color: #c0c0c0
      text-offset: -10 0
      @onOptionChange: modules.game_helper.updateAutoTargetMode(self:getCurrentOption().text)
      @onSetup: |
        self:addOption("A")
        self:addOption("B")
        self:addOption("C")
        self:addOption("D")
        self:addOption("E")
        self:addOption("F")
        self:addOption("G")
        self:addOption("H")
        self:addOption("I")
        self:setCurrentOption("A")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Mode A = Prioritizes the closest target\nMode B = Prioritizes the farthest target\nMode C = Prioritizes target with the lowest health\nMode D = Prioritizes target with the highest health\nMode E = Prioritizes the best target to throw runes (diamond arrows for paladins)\nMode F = Attacks the closest target, prioritizing the one with the lowest health\nMode G = Prioritizes the closest target with the highest health\nMode H = Prioritizes the farthest target with the lowest health\nMode I = Prioritizes the farthest target with the highest health')
    Button
      id: setKeyAutoTargetButton
      size: 43 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Set Key')
      margin-left: 20
      margin-top: -2
      @onClick: manageHotkeys("Enable/Disable Auto Target")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle auto target on/off.')
    CheckBox
      id: enableMagicShooter
      width: 160
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable Shooter Helper')
      margin-left: 2
      margin-top: 8
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 13 -3
      @onCheckChange: toggleMagicShooter(self)
      change-cursor-image: false
      $hover !disabled:
      color: #c0c0c0
    Button
      id: setKeyMSButton
      size: 43 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Set Key')
      margin-left: 27
      margin-top: -2
      @onClick: manageHotkeys("Enable/Disable Magic Shooter")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle TyronCaster on/off.')
    Button
      id: setKeyDisableButton
      height: 15
      anchors.top: setKeyMSButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 2
      margin-right: 32
      image-source: /images/ui/buttons-blue
      !text: tr('Set Key (Target/Shooter)')
      color: #f7f7f7
      @onClick: manageHotkeys("Enable/Disable Target and Magic Shooter")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle TyronCaster and Target on/off.')

SettingsPanel < Panel
  anchors.fill: parent
  Panel
    id: settingsPanel
    height: 112
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: settingsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Preset Manager')
      font: Verdana Bold-11px
      color: #909090
      text-auto-resize: true

    Label
      id: presetLabel
      anchors.top: settingsTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      !text: tr('Preset')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    ComboBox
      id: presetCombo
      size: 150 20
      anchors.top: presetLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 3
      color: #c0c0c0
      text-offset: -10 0
      @onOptionChange: settingsSelectPreset(self:getCurrentOption().text)

    Button
      id: newPresetBtn
      size: 58 20
      anchors.top: presetCombo.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 10
      !text: tr('New')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      @onClick: settingsNewPreset()
    Button
      id: dupPresetBtn
      size: 64 20
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Duplicate')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      @onClick: settingsDuplicatePreset()
    Button
      id: renamePresetBtn
      size: 58 20
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Rename')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      @onClick: settingsRenamePreset()
    Button
      id: deletePresetBtn
      size: 54 20
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Delete')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      @onClick: settingsDeletePreset()

  Panel
    id: exportPanel
    height: 178
    anchors.top: settingsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: exportTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Export Settings')
      font: Verdana Bold-11px
      color: #909090
      text-auto-resize: true
    Label
      id: exportLabel
      anchors.top: exportTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      !text: tr('Export')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    TextEdit
      id: exportEdit
      height: 18
      anchors.top: exportLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 12
      margin-right: 12
      editable: false
    Button
      id: exportBtn
      size: 130 20
      anchors.top: exportEdit.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      !text: tr('Generate')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      !tooltip: tr('Generate your full config code for this vocation; then click again to copy it.')
      @onClick: settingsExportFull()
    HorizontalSeparator
      id: exportImportSep
      anchors.top: exportBtn.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 12
      margin-right: 12
    Label
      id: importLabel
      anchors.top: exportImportSep.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      !text: tr('Import')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    TextEdit
      id: importEdit
      height: 18
      anchors.top: importLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 12
      margin-right: 12
      @onTextChange: settingsValidateImport(self:getText())
    Button
      id: importBtn
      size: 130 20
      anchors.top: importEdit.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      !text: tr('Load')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 0 0
      enabled: false
      !tooltip: tr('Paste a config code from your vocation, then click to import as a new preset.')
      @onClick: settingsImportFull()

NewHeadlessWindow
  id: helperWindow
  anchors.horizontalCenter: parent.horizontalCenter
  size: 295 365
  @onEscape: hide()

  Panel
    id: vocationBanner
    size: 125 28
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 1
    margin-left: 12
    image-source: /images/game/destiny_wheel/menuBg
    image-border: 1
    phantom: true

    UIWidget
      id: vocationIcon
      size: 20 20
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      image-source: /images/game/battle/icon-battlelist-paladin
      phantom: true

    Label
      id: vocationName
      anchors.left: vocationIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text: Paladin
      font: Verdana Bold-11px
      color: #e7d39a
      text-auto-resize: true
      phantom: true

  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -33
    image-source: /images/game/tutorial/backdrop_crest
    phantom: true

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 15 13 17 13
    Panel
      id: optionsTabBar
      height: 36
      image-source: /images/game/destiny_wheel/menuBg
      image-border: 1
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      Button
        id: healingMenu
        anchors.top: parent.top
        anchors.left: parent.left
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 0 136 34 34
        font: verdana-11px-monochrome
        text-align: left
        $hover !checked:
          image-clip: 0 136 34 34
        $pressed:
          image-clip: 0 170 34 34
        $checked:
          size: 136 34
          image-clip: 0 0 136 34
          text-align: left
          text-offset: 38 1
          color: #c0c0c0
        @onClick: loadMenu('healingMenu')
      Button
        id: toolsMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 34 136 34 34
        font: verdana-11px-monochrome
        text-align: left
        $hover !checked:
          image-clip: 34 136 34 34
        $pressed:
          image-clip: 34 170 34 34
        $checked:
          size: 136 34
          image-clip: 0 34 136 34
          text-align: left
          text-offset: 38 1
          color: #c0c0c0
        @onClick: loadMenu('toolsMenu')
      Button
        id: shooterMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 68 136 34 34
        font: verdana-11px-monochrome
        text-align: left
        visible: true
        enabled: true
        $hover !checked:
          image-clip: 68 136 34 34
        $pressed:
          image-clip: 68 170 34 34
        $checked:
          size: 136 34
          image-clip: 0 68 136 34
          text-align: left
          text-offset: 38 1
          color: #c0c0c0
        @onClick: loadMenu('shooterMenu')

      Button
        id: presetsMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 102 136 34 34
        font: verdana-11px-monochrome
        text-align: left
        $hover !checked:
          image-clip: 102 136 34 34
        $pressed:
          image-clip: 102 170 34 34
        $checked:
          size: 136 34
          image-clip: 0 102 136 34
          text-align: left
          text-offset: 38 1
          color: #c0c0c0
        @onClick: loadMenu('presetsMenu')

      Button
        id: cavebotMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/2pixel_up_frame_borderimage
        image-border: 5
        icon: /modules/game_helper/images/icon-speed
        icon-width: 18
        icon-height: 18
        icon-offset: 8 8
        font: verdana-11px-monochrome
        text-align: left
        $checked:
          size: 136 34
          text-align: left
          text-offset: 38 1
          color: #c0c0c0
        @onClick: loadMenu('cavebotMenu')

    HealingPanel
      id: healingPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    ToolsPanel
      id: toolsPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    ShooterPanel
      id: shooterPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    SettingsPanel
      id: settingsPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    PainelCavebotClean
      id: cavebotPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: separator.top
      margin-top: 5
      margin-left: 0
      margin-right: 0
      margin-bottom: 7
      visible: false

    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 7

    Button
      id: close
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Close')
      size: 43 20
      @onClick: hide()

    Button
      id: tracker
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 5
      !text: tr('Helper Stats')
      size: 73 20
      @onClick: toggleHelperTracker()

    Label
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 8
      !text: tr('Helper Status:')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true

    Label
      id: helperStatusLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Status')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true

    UIButton
      id: helperStatus
      size: 12 9
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: 2
      image-source: /images/store/icon-yes
      @onClick: botStatus()
      !tooltip: tr(' - Helper Status: [ENABLED]')

    Button
      id: setKeyHelperButton
      size: 41 15
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: -3
      !text: tr('Set Key')
      @onClick: manageHotkeys("Enable/Disable Helper")

HelperGMVocButton < Button
  size: 92 24
  margin-top: 6
  anchors.horizontalCenter: parent.horizontalCenter

  $checked:
    color: #ffd700
    image-color: #ffffffff

HelperGMVocSwitch < Panel
  id: helperGMVocSwitch
  size: 112 224
  image-source: /images/game/destiny_wheel/menuBg
  image-border: 4
  visible: false

  Label
    id: gmTitle
    !text: tr('GM Vocation')
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    color: #ffd700
    font: verdana-11px-rounded
    text-auto-resize: true

  HelperGMVocButton
    id: gmKnight
    !text: tr('Knight')
    anchors.top: gmTitle.bottom
    @onClick: switchGMVocation(8)

  HelperGMVocButton
    id: gmPaladin
    !text: tr('Paladin')
    anchors.top: prev.bottom
    @onClick: switchGMVocation(7)

  HelperGMVocButton
    id: gmSorcerer
    !text: tr('Sorcerer')
    anchors.top: prev.bottom
    @onClick: switchGMVocation(5)

  HelperGMVocButton
    id: gmDruid
    !text: tr('Druid')
    anchors.top: prev.bottom
    @onClick: switchGMVocation(6)

  HelperGMVocButton
    id: gmMonk
    !text: tr('Monk')
    anchors.top: prev.bottom
    @onClick: switchGMVocation(9)
