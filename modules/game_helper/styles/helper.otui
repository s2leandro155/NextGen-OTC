ToolsPanel < Panel
  anchors.fill: parent
  Panel
    id: toolsPanel
    height: 159
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: toolsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Tools Helper')
      font: Verdana Bold-11px
      color: #909090
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Mana Training')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
      UIButton
        id: spellTrainingButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: enableTraining0
        width: 100
        anchors.top: prev.top
        anchors.left: spellTrainingButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: Verdana Bold-11px
        color: #c0c0c0
        text-offset: 13 -3
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
        @onCheckChange: modules.game_helper.onEnableTraining(self:getId(), self:isChecked())

      ComboBox
        id: spellTrainingPercent0
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: spellTrainingButton0.right
        margin-top: 2
        margin-left: 5
        color: #c0c0c0
        text-offset: -10 0
        @onOptionChange: updateTrainingPercent('spellTrainingButton0', self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          for i = 10, 100, 10 do
            self:addOption(i .. "%")
          end
          self:setCurrentOption("100%")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Cast a spell when your mana reaches the defined percentage to avoid regeneration waste.')
      HorizontalSeparator
        id: separator
        anchors.top: spellTrainingButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Exercise Training')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
        margin-top: 5
      UIButton
        id: autoTrainingItem
        size: 34 34
        anchors.top: toolsLabel.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: autoTrainingCheck
        width: 100
        anchors.top: prev.top
        anchors.left: autoTrainingItem.right
        !text: tr('Enable')
        margin-left: 5
        font: Verdana Bold-11px
        color: #c0c0c0
        text-offset: 13 -3
        @onCheckChange: modules.game_helper.toggleExerciseTraining(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
      ComboBox
        id: trainingBox
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: spellTrainingButton0.right
        margin-top: 2
        margin-left: 5
        color: #c0c0c0
        text-offset: -10 0
        enabled: false
        @onSetup: |
          self:addOption("")
          self:setCurrentOption("")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Feature is being developed.')
    VerticalSeparator
      id: separator1
      anchors.top: toolsTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    Panel
      id: secondPanel
      anchors.top: toolsTitle.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Auto Haste')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
      UIButton
        id: hasteButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: enableHaste0
        width: 100
        anchors.top: prev.top
        anchors.left: hasteButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: Verdana Bold-11px
        color: #c0c0c0
        text-offset: 13 -3
        @onCheckChange: toggleAutoHaste(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
      CheckBox
        id: castOnPz
        width: 100
        anchors.top: prev.bottom
        anchors.left: hasteButton0.right
        !text: tr('PZ Cast')
        margin-left: 5
        margin-top: 5
        font: Verdana Bold-11px
        color: #c0c0c0
        text-offset: 13 -3
        @onCheckChange: toggleAutoHastePz(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
      HorizontalSeparator
        id: separator
        anchors.top: hasteButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel2
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Eat Food')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
        margin-top: 5
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 2
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Select a food item, then choose the minimum food time.\nWhen your food time drops below it, the chosen food is eaten automatically.')
      UIButton
        id: autoFoodItem
        size: 34 34
        anchors.top: toolsLabel2.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: autoFoodCheck
        width: 100
        anchors.top: prev.top
        anchors.left: autoFoodItem.right
        !text: tr('Enable')
        margin-left: 5
        font: Verdana Bold-11px
        color: #c0c0c0
        text-offset: 13 -3
        @onCheckChange: modules.game_helper.toggleAutoEat(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
      ComboBox
        id: foodTimeBox
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: autoFoodItem.right
        margin-top: 2
        margin-left: 5
        color: #c0c0c0
        text-offset: -10 0
        @onOptionChange: modules.game_helper.setAutoFoodMinTime(self:getCurrentOption().text)
        @onSetup: |
          self:addOption("1min")
          self:addOption("2min")
          self:addOption("5min")
          self:addOption("10min")
          self:addOption("20min")
          self:addOption("30min")
          self:setCurrentOption("5min")

  Panel
    id: supportPanel
    height: 74
    anchors.top: toolsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: supportTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Support')
      font: Verdana Bold-11px
      color: #909090
      text-auto-resize: true
    Panel
      id: supportFirst
      anchors.top: supportTitle.bottom
      anchors.left: parent.left
      anchors.right: supportSep.left
      anchors.bottom: parent.bottom
      margin: 5 6 5 5
      Label
        id: autolootLabel
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        !text: tr('Anti Paralyze')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
      UIWidget
        id: autolootHelp
        size: 12 12
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 5
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Casts a configured healing spell immediately when you become paralyzed.')
      Button
        id: autolootToggle
        size: 60 20
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 7
        icon: /images/store/icon-no
        icon-size: 12 9
        icon-align: left
        icon-offset: 7 5
        text-offset: 12 0
        !text: tr('Off')
        !tooltip: tr('Toggle automatic healing when paralysis starts.')
        @onClick: modules.game_helper.toggleSupportAutoloot()
    VerticalSeparator
      id: supportSep
      anchors.top: supportTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    Panel
      id: supportSecond
      anchors.top: supportTitle.bottom
      anchors.left: supportSep.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 6
      Label
        id: flaskLabel
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        !text: tr('Flask')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
      UIWidget
        id: flaskHelp
        size: 12 12
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 5
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('When enabled, the empty flask is automatically removed after drinking a potion.')
      Button
        id: flaskToggle
        size: 60 20
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 7
        icon: /images/store/icon-yes
        icon-size: 12 9
        icon-align: left
        icon-offset: 7 5
        text-offset: 12 0
        !text: tr('On')
        !tooltip: tr('Toggle automatic removal of the empty flask after you drink a potion.\nWhen ON the empty flask is discarded; when OFF it stays in your bag.')
        @onClick: modules.game_helper.toggleSupportFlask()

  Panel
    id: utilitiesPanel
    height: 92
    anchors.top: supportPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: utilitiesTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Utilities')
      font: Verdana Bold-11px
      color: #909090
      text-auto-resize: true
    CheckBox
      id: reconnect
      anchors.top: utilitiesTitle.bottom
      anchors.left: parent.left
      !text: tr('Auto Reconnect')
      margin-top: 8
      margin-left: 8
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 13 -3
      text-auto-resize: true
      @onCheckChange: toggleReconnect(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0
      !tooltip: tr('Automatically reconnects to the game when your connection drops.')
    CheckBox
      id: changeGold
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Change Gold')
      margin-top: 6
      margin-left: 8
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 13 -3
      text-auto-resize: true
      change-cursor-image: false
      @onCheckChange: modules.game_helper.toogleChangeGold(self:isChecked())
      $hover !disabled:
        color: #c0c0c0
      !tooltip: tr('The gold exchange will only work if the gold container is open.')
    CheckBox
      id: rustyRemover
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Auto Rusty Remover')
      margin-top: 6
      margin-left: 8
      font: Verdana Bold-11px
      color: #c0c0c0
      text-offset: 13 -3
      text-auto-resize: true
      @onCheckChange: modules.game_helper.toggleRustyRemover(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0
      !tooltip: tr('Automatically uses a Rust Remover on your rusty equipment\nevery few seconds while you are not casting or drinking potions.\nRequires a Rust Remover and at least one rusty item; otherwise it stays disabled.')
    UIWidget
      id: rustyHelp
      size: 12 12
      anchors.verticalCenter: rustyRemover.verticalCenter
      anchors.left: rustyRemover.right
      margin-left: 5
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Cleans rusty armor, legs, shields and helmets using a Rust Remover.\nA Rust Remover and at least one rusty item are required to enable this function.')

