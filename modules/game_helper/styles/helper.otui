    anchors.right: parent.right
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 10
    padding: 3
    Label
      id: presetsLabel
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      !text: tr('Presets:')
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
    ComboBox
      id: presets
      size: 90 20
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 7
      color: #c0c0c0
      text-offset: -10 0
      @onOptionChange: toggleShooterPreset(self)
    UIButton
      id: rmvPresetButton
      size: 25 20
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      image-source: /images/ui/rmv-button
      image-clip: 0 0 25 20
      !tooltip: tr('Remove Preset')
      $hover !pressed:
        image-clip: 0 0 25 20
      $pressed:
        image-clip: 0 20 25 20
      @onClick: removeProfile()
    Button
      id: setKeyPresetButton
      size: 41 15
      anchors.top: presetsLabel.top
      anchors.left: presetsLabel.right
      !text: tr('Set Key')
      margin-left: 5
      @onClick: manageHotkeys("Change Shooter Preset")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to switch the preset.')
    VerticalSeparator
      id: sep1
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-bottom: 5
    Button
      id: renameButton
      size: 120 20
      anchors.top: parent.top
      anchors.right: parent.right
      !text: tr('Rename Preset')
      font: Verdana Bold-11px
      color: #c0c0c0
      margin-top: 2
      margin-right: 5
      !tooltip: tr('Rename the current preset.')
      @onClick: sendRenameOrAddWindow(true)
    Button
      id: saveButton
      size: 120 20
      anchors.top: presets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      font: Verdana Bold-11px
      color: #c0c0c0
      image-source: /images/ui/buttons-blue
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendRenameOrAddWindow(false)

