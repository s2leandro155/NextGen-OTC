  MultiActionSlot
    id: slot3
    anchors.top: parent.top
    anchors.left: label3.right
    margin-top: 6
    margin-left: 6

  MultiActionArrow
    id: arrow2
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 37
    margin-left: 12

  Label
    id: label2
    anchors.top: parent.top
    anchors.left: parent.left
    size: 20 34
    margin-top: 41
    margin-left: 6
    text-align: center
    font: verdana-11px-rounded
    color: #c0c0c0aa
    !text: 'II'

  MultiActionSlot
    id: slot2
    anchors.top: parent.top
    anchors.left: label2.right
    margin-top: 42
    margin-left: 6

  MultiActionArrow
    id: arrow1
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 76
    margin-left: 12

  Label
    id: label1
    anchors.top: parent.top
    anchors.left: parent.left
    size: 20 34
    margin-top: 78
    margin-left: 6
    text-align: center
    font: verdana-11px-rounded
    color: #c0c0c0aa
    !text: 'I'

  MultiActionSlot
    id: slot1
    anchors.top: parent.top
    anchors.left: label1.right
    margin-top: 78
    margin-left: 6
