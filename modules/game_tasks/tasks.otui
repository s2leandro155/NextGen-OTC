MainWindow
  id: tasksWindow
  !text: 'Tasks'
  size: 911 650
  @onEnter: |
    if self.main.gridPanel:isVisible() then
      modules.game_tasks.reloadPageContent(true, true)
    end

  @onEscape: |
    modules.game_tasks.hide()

  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -63
    image-source: /images/game/tutorial/backdrop_crestr
    phantom: true

  UIWidget
    id: main
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: separator.top
    margin-bottom: 10

    UIWidget
      id: gridPanel
      anchors.fill: parent
      visible: false

      UIWidget
        id: tabs
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 65
        image-source: images/button_phantom
        image-border: 3
        image-clip: 1 44 20 24
        padding: 1
        layout:
          type: horizontalBox

        TaskTabButton
          !text: 'Greenhorn'
          &gifFrames: 1
          &gifSource: 'images/icon_1'

        TaskTabButton
          !text: 'Adventurer'
          &gifFrames: 1
          &gifSource: 'images/icon_2'

        TaskTabButton
          !text: 'Hunter'
          &gifFrames: 15
          &gifSource: 'images/icon_3'

        TaskTabButton
          !text: 'Scrapper'
          &gifFrames: 15
          &gifSource: 'images/icon_4'

        TaskTabButton
          !text: 'Warlord'
          &gifFrames: 15
          &gifSource: 'images/icon_5'

        Button
          id: taskStore
          size: 72 63
          text: ''
          image-source: images/button_phantom
          image-clip: 1 44 20 24
          image-border: 3
          tooltip: Open the Task Coin store
