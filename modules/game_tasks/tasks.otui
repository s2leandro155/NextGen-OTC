  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.bottom: close.top
    anchors.right: parent.right
    margin-bottom: 10

  Button
    id: close
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    font: cipsoftFont
    color: white
    width: 65
    margin-top: 10
    !text: 'Close'
    @onClick: |
      modules.game_tasks.hide()

  CheckBox
    id: trackerCheckbox
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 10
    width: 95
    font: verdana-11px-rounded
    color: #C0C0C0
    !text: 'Show Tracker'
    @onCheckChange: modules.game_tasks.toggleTracker(self:isChecked())

