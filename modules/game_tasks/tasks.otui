TaskExerciseWindow < UIWindow
  size: 560 190
  anchors.centerIn: parent
  image-source: /images/ui/window_headless.png
  image-clip: 0 0 256 239
  image-border: 40
  @onEscape: modules.game_tasks.hideExerciseWindow()

  Label
    id: instructionLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    !text: tr('Select your exercise weapon reward\nChoose one exercise weapon as your task reward')
    text-align: center
    font: verdana-11px-monochrome
    color: #C0C0C0
    size: 500 40
    text-wrap: true

  Panel
    id: exerciseGrid
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 19
    margin-top: 68
    size: 530 80
    clipping: false
    layout:
      type: grid
      cell-size: 66 66
      cell-spacing: 9
      num-lines: 1
      flow: true
      fit-children: true

  HorizontalSeparator
    id: separator
    anchors.top: exerciseGrid.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 16
    size: 528 2

  UIWidget
    image-source: /images/game/tutorial/backdrop_crest
    anchors.bottom: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -20

  Button
    id: close
    anchors.top: separator.bottom
    anchors.right: parent.right
    margin-top: 9
    margin-right: 16
    !text: tr('Cancel')
    font: cipsoftFont
    color: #F4F4F4
    size: 50 20
    @onClick: modules.game_tasks.hideExerciseWindow()

  Button
    id: confirm
    anchors.top: separator.bottom
    anchors.right: close.left
    margin-top: 9
    margin-right: 5
    !text: tr('Confirm')
    font: cipsoftFont
    color: #F4F4F4
    size: 63 20
    image-source: /images/ui/buttons-blue
    image-clip: 0 0 43 20
    @onClick: modules.game_tasks.confirmExerciseReward()
    $pressed:
      image-clip: 0 20 43 20

TaskTabButton < ButtonBox
  image-source: images/button_phantom
  image-clip: 1 0 20 23
  image-border: 3
  change-cursor-image: false
  padding-top: 0
  padding-left: 5
  size: 84 65
  text-offset: 84 0
  text-align: left
  color: #00000000
  @onCheckChange: |
    if self.ignoreCallback then
      return
    end
    if not(self:isChecked()) then
      self.ignoreCallback = true
      self:setChecked(true)
      self.ignoreCallback = nil
      return
    end
    for _, c in ipairs(self:getParent():getChildren()) do
      if c:isChecked() and c ~= self then
        c.ignoreCallback = true
        c:setChecked(false)
        c.ignoreCallback = nil
      end
    end
    local stage = modules.game_tasks.getCurrentTaskSelectedStage()
    modules.game_tasks.requestCategory(stage)
    modules.game_tasks.reloadPageContent(false, true)

  @onSetup: |
    local icon = self:getChildById('icon')
    icon:setImageSource(self.gifSource)
    if self.gifFrames > 1 and icon.setGifDuration then
      icon:setGifDuration(100)
      icon:setGifSource(self.gifSource)
      icon:setGifFrames(self.gifFrames)
      icon:setGifRect(torect("0 0 65 64"))
      icon:setImageClip(torect("0 0 65 64"))
    end

  $hover !disabled:
    image-clip: 1 0 20 23

  $checked:
    image-clip: 0 46 22 23
    text-offset: 75 2
    change-cursor-image: false
    padding-top: 1
    color: #C0C0C0
    padding-left: 6
    size: 170 65

  UIWidget
    id: icon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 65 64
    phantom: true

