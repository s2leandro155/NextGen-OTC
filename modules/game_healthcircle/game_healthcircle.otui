ArcConditionIcon < UIWidget
  size: 9 9
  phantom: true

ArcConditionsBar < UIConditionsPanel
  phantom: true
  focusable: false
  fill-color: #00000080
  edge-antialias: true
  edge-aa-width: 2
  edge-aa-opacity: 0.9

  UIWidget
    id: icons
    anchors.fill: parent
    phantom: true
    layout:
      type: verticalBox
      spacing: 0
