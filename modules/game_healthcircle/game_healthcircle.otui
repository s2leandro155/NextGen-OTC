HealthProgressArc < UIProgressArc
  size: 14 300
  arc-layout: left
  start-angle: 225
  total-span: 90
  ring-thickness: 24
  empty-track: true
  track-color: #0000003C
  fill-color: #ffffffff
  arc-border: true
  arc-border-color: #000000
  arc-border-width: 1
  arc-border-antialias: true
  arc-border-aa-width: 1
  arc-border-aa-opacity: 0.6
  arc-cut-antialias: true
  arc-cut-aa-width: 1
  phantom: true

